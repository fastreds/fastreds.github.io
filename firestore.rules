rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core collection and all its subcollections
    match /fastreds.github.io/{userId}/{document=**} {
      // Allow access if the authenticated user's ID matches the document path ID
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fallback for legacy dot-notation collections if the user is using them
    match /{collectionName}/{docId} {
      allow read, write: if request.auth != null 
                        && collectionName.startsWith("fastreds.github.io")
                        && (resource == null || resource.data.userId == request.auth.uid)
                        && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
