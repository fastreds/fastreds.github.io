rules_version = '2';

// Especificar la base de datos "default"
service cloud.firestore {
  match /databases/default/documents {
    
    // Colección principal del dashboard fastreds.github.io
    match /fastreds.github.io/{userId} {
      // Solo usuarios autenticados pueden leer y escribir
      // Cada usuario solo puede acceder a su propio documento
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Validación adicional para creación
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['email']);
      
      // Validación para actualización
      allow update: if request.auth != null 
                    && request.auth.uid == userId;
    }
    
    // Denegar acceso a cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
